<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|Win32">
      <Configuration>Debug</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|Win32">
      <Configuration>Release</Configuration>
      <Platform>Win32</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>18.0</VCProjectVersion>
    <Keyword>Win32Proj</Keyword>
    <ProjectGuid>{84130ce9-f253-4377-aedc-c25d5bc102ef}</ProjectGuid>
    <RootNamespace>MCDR</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)'=='Debug'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>true</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)'=='Release'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <UseDebugLibraries>false</UseDebugLibraries>
    <PlatformToolset>v145</PlatformToolset>
    <WholeProgramOptimization>true</WholeProgramOptimization>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <ImportGroup Label="ExtensionSettings">
  </ImportGroup>
  <ImportGroup Label="PropertySheets">
    <Import Project="$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props" Condition="exists('$(UserRootDir)\Microsoft.Cpp.$(Platform).user.props')" Label="LocalAppDataPlatform" />
  </ImportGroup>
  <PropertyGroup Label="UserMacros" />
  <PropertyGroup>
    <TargetName>MCDR</TargetName>
    <OutDir>$(ProjectDir)target\$(Platform)_$(Configuration)\</OutDir>
    <IntDir>build\$(Platform)_$(Configuration)\</IntDir>
  </PropertyGroup>
  <PropertyGroup Label="Vcpkg">
    <VcpkgEnableManifest>true</VcpkgEnableManifest>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <!-- Everything here applies to all four configurations, so the language
         standard, warning level and export macro can never drift between them.
         The project is C++23 (/std:c++latest) on MSVC v145 by requirement; the
         D3D12/DXGI headers are clean at /W3 under it. -->
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <SDLCheck>true</SDLCheck>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpplatest</LanguageStandard>
      <LanguageStandard_C>stdclatest</LanguageStandard_C>
      <TreatWarningAsError>true</TreatWarningAsError>
      <MultiProcessorCompilation>true</MultiProcessorCompilation>
      <!-- The core deliberately uses getenv()/fopen() for the DX12_DIAG_* and
           DX12_DBG_* diagnostic switches; suppressing the CRT deprecation nag is
           preferable to touching 4.5k lines of working renderer code.
           NOMINMAX is defined here for the whole project rather than relying on the
           per-header #ifndef guards the core carries: several of those guards reset
           __cplusplus-visible state inconsistently, and with TreatWarningAsError=true
           a single unguarded <windows.h> inclusion turning min/max into macros is a
           hard build failure in D3D12 template code. Defining it globally is
           idempotent for the existing guards. -->
      <PreprocessorDefinitions>_CRT_SECURE_NO_WARNINGS;NOMINMAX;MCDR_EXPORTS;_WINDOWS;_USRDLL;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(ProjectDir)include;$(ProjectDir)src\abi;$(ProjectDir)src\dx12;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
      <!-- These sources have Chinese comments; without /utf-8 the compiler
           reads them under the active code page and mangles them. -->
      <AdditionalOptions>/utf-8 %(AdditionalOptions)</AdditionalOptions>
      <PrecompiledHeader>NotUsing</PrecompiledHeader>
      <UseFullPaths>false</UseFullPaths>
      <ScanSourceForModuleDependencies>true</ScanSourceForModuleDependencies>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <EnableUAC>false</EnableUAC>
      <!-- d3d12/dxgi: the API and the swapchain. d3dcompiler: D3DCompile, the
           HLSL SM5.1 -> DXBC path the pipeline builder still uses (the SM6.x/DXC
           toolchain is a later stage). dcomp: the DirectComposition fallback for
           CreateSwapChainForHwnd returning E_ACCESSDENIED. -->
      <AdditionalDependencies>d3d12.lib;dxgi.lib;d3dcompiler.lib;dcomp.lib;user32.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Link>
    <Manifest>
      <EnableSegmentHeap>true</EnableSegmentHeap>
    </Manifest>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Debug'">
    <ClCompile>
      <PreprocessorDefinitions>_DEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)'=='Release'">
    <ClCompile>
      <PreprocessorDefinitions>NDEBUG;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <FunctionLevelLinking>true</FunctionLevelLinking>
      <IntrinsicFunctions>true</IntrinsicFunctions>
    </ClCompile>
    <Link>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>
      <OptimizeReferences>true</OptimizeReferences>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <!-- Public C ABI. This is the only header the JVM side mirrors. -->
    <ClInclude Include="include\mcdr_abi.h" />
    <!-- Internal adapters. -->
    <ClInclude Include="src\abi\abi_common.h" />
    <!-- D3D12 core (JNI-free; unchanged from the source project apart from the
         deviceContextForJni -> deviceContext rename). -->
    <ClInclude Include="src\dx12\dx12_device.h" />
    <ClInclude Include="src\dx12\dx12_descriptor_allocator.h" />
    <ClInclude Include="src\dx12\dx12_async_executor.h" />
    <ClInclude Include="src\dx12\dx12_async_bundle.h" />
    <ClInclude Include="src\dx12\dx12_async_descriptor.h" />
    <ClInclude Include="src\dx12\dx12_async_fence.h" />
  </ItemGroup>
  <ItemGroup>
    <ClCompile Include="src\core\dllmain.cpp" />
    <ClCompile Include="src\abi\abi_common.cpp" />
    <ClCompile Include="src\abi\abi_meta.cpp" />
    <ClCompile Include="src\abi\abi_bridge.cpp" />
    <ClCompile Include="src\abi\abi_bridge_p3.cpp" />
    <ClCompile Include="src\abi\abi_bridge_p4.cpp" />
    <ClCompile Include="src\abi\abi_bridge_p5.cpp" />
    <ClCompile Include="src\abi\abi_bridge_p6.cpp" />
    <ClCompile Include="src\abi\abi_bridge_p33.cpp" />
    <ClCompile Include="src\dx12\dx12_descriptor_allocator.cpp" />
    <ClCompile Include="src\dx12\dx12_device.cpp" />
    <ClCompile Include="src\dx12\dx12_surface.cpp" />
    <ClCompile Include="src\dx12\dx12_async_executor.cpp" />
    <ClCompile Include="src\dx12\dx12_async_bundle.cpp" />
    <ClCompile Include="src\dx12\dx12_async_descriptor.cpp" />
    <ClCompile Include="src\dx12\dx12_async_fence.cpp" />
  </ItemGroup>
